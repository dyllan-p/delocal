Stops `WantList::insert` from adding every other member as a source when
it admits a want at a marked path (f53c1de); the want still carries the
mark. Such a want asks only the batch's source and the members that
announced its content, so when that content exists nowhere it goes
without source instead of settling as unrecoverable once every member
has refused (DESIGN.md §8.3 step 2 and step 4).

test: delocal-sim regressions::a_marked_want_whose_content_exists_nowhere_settles_unrecoverable

diff --git a/crates/engine/src/want.rs b/crates/engine/src/want.rs
index a48d211..b5da8cb 100644
--- a/crates/engine/src/want.rs
+++ b/crates/engine/src/want.rs
@@ -371,9 +371,8 @@ impl WantList {
         if let Some(existing) = self.wants.get_mut(&path) {
             if incoming == *existing.version() {
                 existing.sources.insert(source);
-                if let Some(others) = marked {
+                if marked.is_some() {
                     existing.restoring = true;
-                    existing.sources.extend(others.iter().copied());
                 }
                 self.note(&path);
                 return None;
@@ -385,9 +384,6 @@ impl WantList {
         }
         let mut want = Want::from_item(item, received, batch, source, seq_high);
         want.restoring = restoring;
-        if let Some(others) = marked {
-            want.sources.extend(others.iter().copied());
-        }
         self.wants.insert(path.clone(), want);
         self.note(&path);
         None
