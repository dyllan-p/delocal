Restores FolderState::fetched in folder.rs to what it was before cfc8bbf: it
records the fetch report on the want and returns, and never settles a
restoring want. Once every member has answered NotAvailable the folder then
writes no tombstone, and the reverted path stays live in the index and absent
on disk for good (DESIGN.md §8.3 step 4).

test: delocal-sim regressions::a_reverted_deletion_nobody_can_serve_stands
test: delocal-engine engine::tests::an_unrecoverable_revert_ends_in_a_tombstone_once_every_member_answered

diff --git a/crates/engine/src/folder.rs b/crates/engine/src/folder.rs
--- a/crates/engine/src/folder.rs
+++ b/crates/engine/src/folder.rs
@@ -2099,39 +2099,13 @@
         version: &Version,
         report: FetchReport,
     ) -> Fetched {
-        let own = self.index.own();
-        // A report the want-list ignored (§7.5: the want was not fetching)
-        // settles nothing, and says nothing about the want's state.
-        let Some(want) = self.wants.fetched(now, path, version, report) else {
-            return Fetched {
-                state: None,
-                unrecoverable: None,
-            };
-        };
-        let unrecoverable = want.restoring
-            && report == FetchReport::NotAvailable
-            && self
-                .members
-                .iter()
-                .all(|m| *m == own || want.answered.contains(m));
-        let state = Some(want.state);
-        if !unrecoverable {
-            return Fetched {
-                state,
-                unrecoverable: None,
-            };
-        }
-        self.wants.remove(path);
-        self.clear_carriers(path);
-        let change = self
-            .index
-            .observe_absent_unrecoverable(path, now.as_unix_nanos());
-        if change.is_some() {
-            self.touched(now);
-        }
+        let state = self
+            .wants
+            .fetched(now, path, version, report)
+            .map(|w| w.state);
         Fetched {
-            state: None,
-            unrecoverable: change,
+            state,
+            unrecoverable: None,
         }
     }
 
